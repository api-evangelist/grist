        {
          "id": "af9030d7-238e-4c57-a538-bceedab8d01d",
          "name": "Run an SQL query against a document, with options or parameters",
          "request": {
            "name": "Run an SQL query against a document, with options or parameters",
            "description": {
              "content": "Execute a read-only SQL SELECT query with support for parameterized queries\nand custom timeouts. All Grist documents are SQLite databases, and queries\nare executed directly against SQLite with security restrictions.\n",
              "type": "text/plain"
            },
            "url": {
              "path": [
                "docs",
                ":docId",
                "sql"
              ],
              "host": [
                "{{baseUrl}}"
              ],
              "query": [],
              "variable": [
                {
                  "disabled": false,
                  "type": "any",
                  "value": "<string>",
                  "key": "docId",
                  "description": "(Required) A string id (UUID)"
                },
                {
                  "description": "The team name, or `docs` for personal areas",
                  "type": "any",
                  "value": "{{subdomain}}",
                  "key": "subdomain"
                }
              ]
            },
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Accept",
                "value": "application/json"
              }
            ],
            "method": "POST",
            "auth": null,
            "body": {
              "mode": "raw",
              "raw": "{\n  \"sql\": \"<string>\",\n  \"args\": [\n    \"<number>\",\n    \"<number>\"\n  ],\n  \"timeout\": \"<number>\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
