          "request": {
            "name": "Run an SQL query against a document",
            "description": {
              "content": "Execute a read-only SQL SELECT query against the document's SQLite database.\nThis is a simplified endpoint for basic queries. For queries with parameters\nor custom timeouts, use the POST endpoint instead.\n",
              "type": "text/plain"
            },
            "url": {
              "path": [
                "docs",
                ":docId",
                "sql"
              ],
              "host": [
