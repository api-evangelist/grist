                  "key": "q",
                  "value": "<string>"
                }
              ],
              "variable": [
                {
                  "disabled": false,
                  "type": "any",
                  "value": "<string>",
                  "key": "docId",
                  "description": "(Required) A string id (UUID)"
                },
                {
                  "description": "The team name, or `docs` for personal areas",
                  "type": "any",
                  "value": "{{subdomain}}",
                  "key": "subdomain"
