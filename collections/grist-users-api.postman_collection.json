          "name": "Delete a user from Grist",
          "request": {
            "name": "Delete a user from Grist",
            "description": {
              "content": "This action also deletes the user's personal organisation and all the workspaces and documents it contains.\nCurrently, only the users themselves are allowed to delete their own accounts.\n\n⚠️ **This action cannot be undone, please be cautious when using this endpoint** ⚠️\n",
              "type": "text/plain"
            },
            "url": {
              "path": [
                "users",
                ":userId"
              ],
              "host": [
                "{{baseUrl}}"
              ],
              "query": [],
              "variable": [
                {
                  "disabled": false,
                  "type": "any",
                  "value": "<integer>",
                  "key": "userId",
                  "description": "(Required) A user id"
                },
                {
                  "description": "The team name, or `docs` for personal areas",
                  "type": "any",
                  "value": "{{subdomain}}",
                  "key": "subdomain"
                }
