                    "{{baseUrl}}"
                  ],
                  "query": [
                    {
                      "key": "filter",
                      "value": "{\"pet\": [\"cat\", \"dog\"]}"
                    },
                    {
                      "key": "sort",
                      "value": "pet,-age"
                    },
                    {
                      "key": "limit",
                      "value": "<number>"
                    },
                    {
                      "key": "hidden",
                      "value": "<boolean>"
                    }
                  ],
                  "variable": [
                    {
                      "disabled": false,
                      "type": "any",
                      "value": "<string>",
