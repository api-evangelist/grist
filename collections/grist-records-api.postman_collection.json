                    "disabled": false,
                    "description": "Same as `sort` query parameter.",
                    "key": "X-Sort",
                    "value": "pet,-age"
                  },
                  {
                    "disabled": false,
                    "description": "Same as `limit` query parameter.",
                    "key": "X-Limit",
                    "value": "<number>"
                  },
                  {
                    "key": "Accept",
                    "value": "application/json"
                  }
                ],
                "method": "GET",
                "body": {}
              },
              "status": "OK",
              "code": 200,
              "header": [
                {
                  "key": "Content-Type",
                  "value": "application/json"
